{
  "name": "chronokrone",
  "private": true,
  "version": "0.1.0",
  "description": "Incremental-Game: Mittelalterreich gegen alberne Aliens, mit Zeitmaschine durch die Epochen.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "simulate": "tsx src/dev/simulate.ts",
    "desktop": "npm run build:desktop && electron .",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop:pack": "npm run build:desktop && electron-builder --win portable",
    "sprites": "node scripts/sprites/build.mjs"
  },
  "dependencies": {
    "break_eternity.js": "^2.2.2",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "main": "electron/main.cjs",
  "author": "Alex",
  "build": {
    "appId": "io.github.alexsyromolot-cyber.chronokrone",
    "productName": "Chronokrone",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Chronokrone-${version}-portable.exe"
    }
  }
}
